# Copy to .env.local for local overrides (gitignored via *.local).
# In production (Vercel), set this as a project Environment Variable instead.

# Backend's public URL. Must be HTTPS in production — a Vercel page is
# served over HTTPS and browsers block it from calling a plain-HTTP API.
# Falls back to http://127.0.0.1:8000 (local dev) if unset.
VITE_API_BASE_URL=https://api.yourdomain.com
